{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/cli": "jsr:@std/cli@^1.0.18",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fmt": "jsr:@std/fmt@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.17",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.13",
    "sanitize-filename": "https://deno.land/x/sanitize_filename/mod.ts"
  },
  "version": "3.0.0",
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "dom"],
    "strict": true
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-env index.ts",
    "compile": "deno compile --allow-read --allow-write --allow-net --allow-env --target x86_64-unknown-linux-gnu --output humble-downloader index.ts"
  },
  "lint": {
    "files": {
      "include": ["*.ts", "utils/", "types/"]
    }
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 80
  }
}
